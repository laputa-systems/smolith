FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
COPY --from=oci.17166969.xyz/owned-tools@sha256:aaec19e7a44cbc53b40db2d22093600ee888689b89be94da90e5398ed02f1883 /opt/laputa /opt/laputa
ENV PATH=$PATH:/opt/laputa/bin

ARG RUST_TOOLCHAIN

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/opt/laputa/bin

RUN apk add --no-cache \
    bash=5.3.9-r1 \
    ca-certificates=20261020-r0 \
    curl=8.23.0-r0 \
    iproute2 \
    jq \
    libgcc=15.2.0-r5 \
    musl-dev=1.2.6-r3 \
    nginx \
    openssl=3.5.9-r1 \
    pkgconf=2.5.1-r0 \
    procps \
    sqlite \
    strace=6.19-r1

# Rust links host proc-macros against -lgcc_s, which only gcc's package symlinks; the C
# compiler and linker driver is the owned clang.
RUN ln -s libgcc_s.so.1 /usr/lib/libgcc_s.so \
    && ln -s /opt/laputa/bin/clang /usr/local/bin/cc
ENV AR=llvm-ar

ARG RUSTUP_VERSION=1.29.1

RUN test -n "$RUST_TOOLCHAIN" \
 && arch=$(uname -m) \
 && case "$arch" in \
      x86_64) sum=331228566cc931f32cd684f9bebc5956a5e5d7394c8d5de595f196a658ab98e6 ;; \
      aarch64) sum=1ddf36182ac5d1782dbeefcb9bea7f5f9412d88f4a0d5047b1564a223624e8c6 ;; \
      *) echo "unsupported architecture $arch" >&2; exit 1 ;; \
    esac \
 && curl --proto '=https' --tlsv1.2 -fsSL -o /tmp/rustup-init "https://static.rust-lang.org/rustup/archive/$RUSTUP_VERSION/$arch-unknown-linux-musl/rustup-init" \
 && echo "$sum  /tmp/rustup-init" | sha256sum -c - \
 && chmod +x /tmp/rustup-init \
 && /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain "$RUST_TOOLCHAIN" \
 && rustup component add --toolchain "$RUST_TOOLCHAIN" rust-src llvm-tools clippy \
 && rm /tmp/rustup-init \
 && rustc -Vv

COPY nginx.conf /etc/nginx/nginx.conf
